# Local development only. Copy to .env; .env is ignored by Git.
PAYMENT_PORT=8084
PAYMENT_MONGO_PORT=27017
PAYMENT_MONGO_DB=payment_service_db
PAYMENT_MONGO_USER=payment_dev
PAYMENT_MONGO_PASSWORD=payment_local_only
PAYMENT_MONGODB_URI=mongodb://payment_dev:payment_local_only@localhost:27017/payment_service_db?authSource=admin&serverSelectionTimeoutMS=5000
ORDER_SERVICE_URL=http://localhost:8083
# Auth runs on 8082 in its standalone config; in the Gateway compose it is internal on 8081.
# For the combined stack, Part 2 will supply the Docker service URL.
AUTH_JWKS_URI=http://localhost:8082/.well-known/jwks.json
AUTH_JWT_ISSUER=authentication-service
AUTH_JWT_AUDIENCE=java-advanced-api
RANDOM_API_URL=https://www.random.org
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PAYMENT_EVENTS_TOPIC=payment-events
PAYMENT_EVENTS_ENABLED=true

# For Docker, tools/prepare-env.ps1 adds PAYMENT_MONGODB_URI_DOCKER using these credentials.
